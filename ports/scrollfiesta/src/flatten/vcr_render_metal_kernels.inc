"#include <metal_stdlib>\n"
"using namespace metal;\n"
"#pragma METAL fp contract(off)\n"
"typedef uchar u8;\n"
"\n"
"static inline void node_at(device const float *X, device const float *Y, device const float *Z, int W, int r, int c,\n"
"                           thread float *p)\n"
"{\n"
"    const long i = (long)r * W + c;\n"
"    p[0] = X[i]; p[1] = Y[i]; p[2] = Z[i];\n"
"    if (p[0] == -1.0f) { p[0] = as_type<float>(0x7fc00000u); p[1] = p[0]; p[2] = p[0]; }\n"
"}\n"
"\n"
"static inline float bil(float p00, float p01, float p10, float p11)\n"
"{\n"
"    const float top = (p00 * 0.5f) + (p01 * 0.5f);\n"
"    const float bot = (p10 * 0.5f) + (p11 * 0.5f);\n"
"    return (top * 0.5f) + (bot * 0.5f);\n"
"}\n"
"\n"
"static int pixel_geom(device const float *X, device const float *Y, device const float *Z, int W, int H, int r, int c,\n"
"                      int flip, thread float *b, thread float *d)\n"
"{\n"
"    const int rn = r + 1, cn = c + 1;\n"
"    float q[3], l[3], rt[3], u[3], w[3], a[3], e[3], f[3], g[3];\n"
"    if (rn >= H || cn >= W) return 0;\n"
"    node_at(X, Y, Z, W, rn, cn, q);\n"
"    if ((q[0] != q[0]) | (q[1] != q[1]) | (q[2] != q[2]) | ((q[0] == -1.f) & (q[1] == -1.f) & (q[2] == -1.f)))\n"
"        return 0;\n"
"    if (rn > H - 2 || cn > W - 2) return 0;\n"
"    node_at(X, Y, Z, W, rn, cn - 1, l);\n"
"    node_at(X, Y, Z, W, rn, cn + 1, rt);\n"
"    node_at(X, Y, Z, W, rn - 1, cn, u);\n"
"    node_at(X, Y, Z, W, rn + 1, cn, w);\n"
"    const float xv0 = rt[0] - l[0], xv1 = rt[1] - l[1], xv2 = rt[2] - l[2];\n"
"    const float yv0 = w[0] - u[0], yv1 = w[1] - u[1], yv2 = w[2] - u[2];\n"
"    float n0 = (xv1 * yv2) - (xv2 * yv1);\n"
"    float n1 = (xv2 * yv0) - (xv0 * yv2);\n"
"    float n2 = (xv0 * yv1) - (xv1 * yv0);\n"
"    const float len2 = ((n0 * n0) + (n1 * n1)) + (n2 * n2);\n"
"    if (len2 == 0.0f || len2 != len2) return 0;\n"
"    const float inv = 1.0f / precise::sqrt(len2);\n"
"    n0 = n0 * inv; n1 = n1 * inv; n2 = n2 * inv;\n"
"    if (flip) { n0 = -n0; n1 = -n1; n2 = -n2; }\n"
"    const float L2 = ((n0 * n0) + (n1 * n1)) + (n2 * n2);\n"
"    if (L2 > 0.0f) {\n"
"        const float ia = 1.0f / precise::sqrt(L2);\n"
"        n0 = n0 * ia; n1 = n1 * ia; n2 = n2 * ia;\n"
"    }\n"
"    d[0] = n0; d[1] = n1; d[2] = n2;\n"
"    node_at(X, Y, Z, W, r, c, a);\n"
"    node_at(X, Y, Z, W, r, c + 1, e);\n"
"    node_at(X, Y, Z, W, r + 1, c, f);\n"
"    node_at(X, Y, Z, W, r + 1, c + 1, g);\n"
"    for (int k = 0; k < 3; k++) b[k] = bil(a[k], e[k], f[k], g[k]);\n"
"    return 1;\n"
"}\n"
"\n"
"static inline float vox(device const int *tab, device const u8 *pool, int sz, int sy, int sx, int cgy, int cgx,\n"
"                        int iz, int iy, int ix)\n"
"{\n"
"    if ((uint)iz >= (uint)sz || (uint)iy >= (uint)sy || (uint)ix >= (uint)sx) return 0.0f;\n"
"    const int slot = tab[((iz >> 7) * cgy + (iy >> 7)) * cgx + (ix >> 7)];\n"
"    if (slot < 0) return 0.0f;\n"
"    return (float)pool[(ulong)slot * 2097152ul + (((ulong)(iz & 127) << 14) | ((ulong)(iy & 127) << 7) | (ulong)(ix & 127))];\n"
"}\n"
"\n"
"static float trilinear(device const int *tab, device const u8 *pool, int sz, int sy, int sx, int cgy, int cgx,\n"
"                       float vz, float vy, float vx)\n"
"{\n"
"    const int iz = (int)vz, iy = (int)vy, ix = (int)vx;\n"
"    const float c000 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz, iy, ix);\n"
"    const float c100 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz + 1, iy, ix);\n"
"    const float c010 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz, iy + 1, ix);\n"
"    const float c110 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz + 1, iy + 1, ix);\n"
"    const float c001 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz, iy, ix + 1);\n"
"    const float c101 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz + 1, iy, ix + 1);\n"
"    const float c011 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz, iy + 1, ix + 1);\n"
"    const float c111 = vox(tab, pool, sz, sy, sx, cgy, cgx, iz + 1, iy + 1, ix + 1);\n"
"    const float fz = vz - (float)iz, fy = vy - (float)iy, fx = vx - (float)ix;\n"
"    const float c00 = fma(fx, c001 - c000, c000);\n"
"    const float c01 = fma(fx, c011 - c010, c010);\n"
"    const float c10 = fma(fx, c101 - c100, c100);\n"
"    const float c11 = fma(fx, c111 - c110, c110);\n"
"    const float c0 = fma(fy, c01 - c00, c00);\n"
"    const float c1 = fma(fy, c11 - c10, c10);\n"
"    return fma(fz, c1 - c0, c0);\n"
"}\n"
"\n"
"static inline int box_of(thread const float *b, thread const float *d, float omin, float omax, int sz, int sy, int sx,\n"
"                         thread int *lo, thread int *hi)\n"
"{\n"
"    const int lim[3] = {sx, sy, sz};\n"
"    for (int k = 0; k < 3; k++) {\n"
"        const float e1 = b[k] + (d[k] * omin), e2 = b[k] + (d[k] * omax);\n"
"        const float mn = fmin(e1, e2), mx = fmax(e1, e2), top = (float)lim[k] + 4.0f;\n"
"        if (!(mx >= -4.0f) || !(mn <= top)) return 0;\n"
"        lo[k] = max(0, (int)floor(fmax(mn, -4.0f)) - 1);\n"
"        hi[k] = min(lim[k] - 1, (int)floor(fmin(mx, top)) + 2);\n"
"        if (lo[k] > hi[k]) return 0;\n"
"    }\n"
"    return 1;\n"
"}\n"
"\n"
"static inline u8 layer_value(int ok, thread const float *b, thread const float *d, float off, device const int *tab,\n"
"                             device const u8 *pool, int sz, int sy, int sx, int cgy, int cgx)\n"
"{\n"
"    if (!ok) return 0;\n"
"    const float px = b[0] + (d[0] * off);\n"
"    const float py = b[1] + (d[1] * off);\n"
"    const float pz = b[2] + (d[2] * off);\n"
"    if (!(pz >= 0.f && py >= 0.f && px >= 0.f && pz < (float)sz && py < (float)sy && px < (float)sx)) return 0;\n"
"    float v = trilinear(tab, pool, sz, sy, sx, cgy, cgx, pz, py, px);\n"
"    if (v < 0.f) v = 0.f;\n"
"    if (v > 255.f) v = 255.f;\n"
"    return (u8)(int)v;\n"
"}\n"
"\n"
"static inline u8 ctmax_value(device const float *X, device const float *Y, device const float *Z, int W, int H, int r,\n"
"                             int c, int flip, int z0, int z1, float zstep, device const int *tab, device const u8 *pool,\n"
"                             int sz, int sy, int sx, int cgy, int cgx)\n"
"{\n"
"    float b[3], d[3];\n"
"    if (!(pixel_geom(X, Y, Z, W, H, r, c, flip, b, d) && isfinite(b[0]))) return 0;\n"
"    float mx = 0.0f;\n"
"    for (int k = z0; k <= z1; k++) {\n"
"        const float z = (float)k * zstep;\n"
"        const float px = b[0] + (d[0] * z);\n"
"        const float py = b[1] + (d[1] * z);\n"
"        const float pz = b[2] + (d[2] * z);\n"
"        float v = 0.0f;\n"
"        if (pz >= 0.f && py >= 0.f && px >= 0.f && pz < (float)sz && py < (float)sy && px < (float)sx) {\n"
"            int iz = (int)(pz + 0.5f), iy = (int)(py + 0.5f), ix = (int)(px + 0.5f);\n"
"            if (iz >= sz) iz = sz - 1;\n"
"            if (iy >= sy) iy = sy - 1;\n"
"            if (ix >= sx) ix = sx - 1;\n"
"            v = vox(tab, pool, sz, sy, sx, cgy, cgx, iz, iy, ix);\n"
"        }\n"
"        mx = fmax(mx, v);\n"
"    }\n"
"    if (mx > 255.f) mx = 255.f;\n"
"    return (u8)(int)mx;\n"
"}\n"
"\n"
"kernel void vcr_mark(device const float *X [[buffer(0)]], device const float *Y [[buffer(1)]], device const float *Z [[buffer(2)]],\n"
"    constant int &W [[buffer(3)]], constant int &H [[buffer(4)]], constant int &flip [[buffer(5)]],\n"
"    constant float &omin [[buffer(6)]], constant float &omax [[buffer(7)]], constant int &sz [[buffer(8)]],\n"
"    constant int &sy [[buffer(9)]], constant int &sx [[buffer(10)]], constant int &cgy [[buffer(11)]],\n"
"    constant int &cgx [[buffer(12)]], device u8 *mask [[buffer(13)]], uint2 gid [[thread_position_in_grid]])\n"
"{\n"
"    const int c = (int)gid.x, r = (int)gid.y;\n"
"    if (c >= W || r >= H) return;\n"
"    float b[3], d[3];\n"
"    int lo[3], hi[3];\n"
"    if (!pixel_geom(X, Y, Z, W, H, r, c, flip, b, d)) return;\n"
"    if (!((b[0] == b[0]) & (b[1] == b[1]) & (b[2] == b[2]))) return;\n"
"    if (!box_of(b, d, omin, omax, sz, sy, sx, lo, hi)) return;\n"
"    for (int cz = lo[2] >> 7; cz <= hi[2] >> 7; cz++)\n"
"        for (int cy = lo[1] >> 7; cy <= hi[1] >> 7; cy++)\n"
"            for (int cx = lo[0] >> 7; cx <= hi[0] >> 7; cx++)\n"
"                mask[(cz * cgy + cy) * cgx + cx] = 1;\n"
"}\n"
"\n"
"kernel void vcr_layers(device const float *X [[buffer(0)]], device const float *Y [[buffer(1)]], device const float *Z [[buffer(2)]],\n"
"    constant int &W [[buffer(3)]], constant int &H [[buffer(4)]], constant int &flip [[buffer(5)]],\n"
"    constant int &r0 [[buffer(6)]], device const int *tab [[buffer(7)]], device const u8 *pool [[buffer(8)]],\n"
"    constant int &sz [[buffer(9)]], constant int &sy [[buffer(10)]], constant int &sx [[buffer(11)]],\n"
"    constant int &cgy [[buffer(12)]], constant int &cgx [[buffer(13)]], device const float *offs [[buffer(14)]],\n"
"    constant int &N [[buffer(15)]], device u8 *out [[buffer(16)]], uint2 gid [[thread_position_in_grid]])\n"
"{\n"
"    const int c = (int)gid.x, ly = (int)gid.y;\n"
"    const int r = r0 + ly;\n"
"    if (c >= W || ly >= 128 || r >= H) return;\n"
"    float b[3], d[3];\n"
"    const int ok = pixel_geom(X, Y, Z, W, H, r, c, flip, b, d);\n"
"    device u8 *o = out + (ulong)(c >> 7) * (ulong)N * 16384ul + (ulong)ly * 128ul + (ulong)(c & 127);\n"
"    for (int i = 0; i < N; i++) o[(ulong)i * 16384ul] = layer_value(ok, b, d, offs[i], tab, pool, sz, sy, sx, cgy, cgx);\n"
"}\n"
"\n"
"kernel void vcr_ctmax(device const float *X [[buffer(0)]], device const float *Y [[buffer(1)]], device const float *Z [[buffer(2)]],\n"
"    constant int &W [[buffer(3)]], constant int &H [[buffer(4)]], constant int &flip [[buffer(5)]],\n"
"    constant int &z0 [[buffer(6)]], constant int &z1 [[buffer(7)]], constant float &zstep [[buffer(8)]],\n"
"    device const int *tab [[buffer(9)]], device const u8 *pool [[buffer(10)]], constant int &sz [[buffer(11)]],\n"
"    constant int &sy [[buffer(12)]], constant int &sx [[buffer(13)]], constant int &cgy [[buffer(14)]],\n"
"    constant int &cgx [[buffer(15)]], device u8 *out [[buffer(16)]], uint2 gid [[thread_position_in_grid]])\n"
"{\n"
"    const int c = (int)gid.x, r = (int)gid.y;\n"
"    if (c >= W || r >= H) return;\n"
"    out[(ulong)r * W + c] = ctmax_value(X, Y, Z, W, H, r, c, flip, z0, z1, zstep, tab, pool, sz, sy, sx, cgy, cgx);\n"
"}\n"
"\n"
"kernel void vcr_mark_rect(device const float *X [[buffer(0)]], device const float *Y [[buffer(1)]], device const float *Z [[buffer(2)]],\n"
"    constant int &W [[buffer(3)]], constant int &H [[buffer(4)]], constant int &flip [[buffer(5)]],\n"
"    constant float &omin [[buffer(6)]], constant float &omax [[buffer(7)]], constant int &sz [[buffer(8)]],\n"
"    constant int &sy [[buffer(9)]], constant int &sx [[buffer(10)]], constant int &cgy [[buffer(11)]],\n"
"    constant int &cgx [[buffer(12)]], constant int &r0 [[buffer(13)]], constant int &c0 [[buffer(14)]],\n"
"    constant int &rh [[buffer(15)]], constant int &cw [[buffer(16)]], constant uint &stamp [[buffer(17)]],\n"
"    device atomic_uint *seen [[buffer(18)]], device atomic_uint *count [[buffer(19)]], device int *keys [[buffer(20)]],\n"
"    constant uint &capacity [[buffer(21)]], uint2 gid [[thread_position_in_grid]])\n"
"{\n"
"    const int c = c0 + (int)gid.x, r = r0 + (int)gid.y;\n"
"    if (c >= c0 + cw || r >= r0 + rh) return;\n"
"    float b[3], d[3];\n"
"    int lo[3], hi[3];\n"
"    if (!pixel_geom(X, Y, Z, W, H, r, c, flip, b, d)) return;\n"
"    if (!((b[0] == b[0]) & (b[1] == b[1]) & (b[2] == b[2]))) return;\n"
"    if (!box_of(b, d, omin, omax, sz, sy, sx, lo, hi)) return;\n"
"    for (int cz = lo[2] >> 7; cz <= hi[2] >> 7; cz++)\n"
"        for (int cy = lo[1] >> 7; cy <= hi[1] >> 7; cy++)\n"
"            for (int cx = lo[0] >> 7; cx <= hi[0] >> 7; cx++) {\n"
"                const int key = (cz * cgy + cy) * cgx + cx;\n"
"                if (atomic_exchange_explicit(seen + key, stamp, memory_order_relaxed) != stamp) {\n"
"                    const uint n = atomic_fetch_add_explicit(count, 1u, memory_order_relaxed);\n"
"                    if (n < capacity) keys[n] = key;\n"
"                }\n"
"            }\n"
"}\n"
"\n"
"kernel void vcr_layers_rect(device const float *X [[buffer(0)]], device const float *Y [[buffer(1)]], device const float *Z [[buffer(2)]],\n"
"    constant int &W [[buffer(3)]], constant int &H [[buffer(4)]], constant int &flip [[buffer(5)]],\n"
"    constant int &r0 [[buffer(6)]], constant int &c0 [[buffer(7)]], constant int &rh [[buffer(8)]],\n"
"    constant int &cw [[buffer(9)]], device const int *tab [[buffer(10)]], device const u8 *pool [[buffer(11)]],\n"
"    constant int &sz [[buffer(12)]], constant int &sy [[buffer(13)]], constant int &sx [[buffer(14)]],\n"
"    constant int &cgy [[buffer(15)]], constant int &cgx [[buffer(16)]], device const float *offs [[buffer(17)]],\n"
"    constant int &N [[buffer(18)]], device u8 *out [[buffer(19)]], uint2 gid [[thread_position_in_grid]])\n"
"{\n"
"    const int c = c0 + (int)gid.x, ly = r0 + (int)gid.y;\n"
"    const int r = ly;\n"
"    if (c >= c0 + cw || ly >= r0 + rh) return;\n"
"    float b[3], d[3];\n"
"    const int ok = pixel_geom(X, Y, Z, W, H, r, c, flip, b, d);\n"
"    device u8 *o = out + (ulong)(c >> 7) * (ulong)N * 16384ul + (ulong)ly * 128ul + (ulong)(c & 127);\n"
"    for (int i = 0; i < N; i++) o[(ulong)i * 16384ul] = layer_value(ok, b, d, offs[i], tab, pool, sz, sy, sx, cgy, cgx);\n"
"}\n"
"\n"
"kernel void vcr_ctmax_rect(device const float *X [[buffer(0)]], device const float *Y [[buffer(1)]], device const float *Z [[buffer(2)]],\n"
"    constant int &W [[buffer(3)]], constant int &H [[buffer(4)]], constant int &flip [[buffer(5)]],\n"
"    constant int &r0 [[buffer(6)]], constant int &c0 [[buffer(7)]], constant int &rh [[buffer(8)]],\n"
"    constant int &cw [[buffer(9)]], constant int &stride [[buffer(10)]], constant int &z0 [[buffer(11)]],\n"
"    constant int &z1 [[buffer(12)]], constant float &zstep [[buffer(13)]], device const int *tab [[buffer(14)]],\n"
"    device const u8 *pool [[buffer(15)]], constant int &sz [[buffer(16)]], constant int &sy [[buffer(17)]],\n"
"    constant int &sx [[buffer(18)]], constant int &cgy [[buffer(19)]], constant int &cgx [[buffer(20)]],\n"
"    device u8 *out [[buffer(21)]], uint2 gid [[thread_position_in_grid]])\n"
"{\n"
"    const int c = c0 + (int)gid.x, r = r0 + (int)gid.y;\n"
"    if (c >= c0 + cw || r >= r0 + rh) return;\n"
"    out[(ulong)r * stride + c] = ctmax_value(X, Y, Z, W, H, r, c, flip, z0, z1, zstep, tab, pool, sz, sy, sx, cgy, cgx);\n"
"}\n"
"\n"
"kernel void vcr_patch_table(device int *tab [[buffer(0)]], device const int *changes [[buffer(1)]], constant int &n [[buffer(2)]],\n"
"    uint gid [[thread_position_in_grid]])\n"
"{\n"
"    const int i = (int)gid;\n"
"    if (i >= n) return;\n"
"    const int old_key = changes[3*i], new_key = changes[3*i+1], slot = changes[3*i+2];\n"
"    if (old_key >= 0) tab[old_key] = -1;\n"
"    tab[new_key] = slot;\n"
"}\n"
