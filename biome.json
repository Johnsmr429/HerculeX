{
  "$schema": "./runtime/node/node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.css",
      "**/*.html",
      "biome.json",
      "!ports/scrollfiesta",
      "!ideas/*/results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": ["M", "TOP", "kept", "floor", "scan", "Shortcuts", "markWrites", "spotReadout"]
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useSemanticElements": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "viewer/assets/sheet_viewer.html",
        "viewer/assets/mark_writes.js",
        "viewer/assets/spot_coordinates.js",
        "viewer/assets/atlas.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["viewer/**", "synthetic/**"],
      "formatter": {
        "indentWidth": 4,
        "lineWidth": 100
      },
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "error"
          }
        }
      }
    }
  ]
}
